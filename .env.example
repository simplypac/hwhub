# Copy to .env for local use. On a host (Railway, Render, Fly) set these as environment variables instead.

# The public address of the app, no trailing slash. Must be https:// in production.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Long random string. Encrypts stored calendar links and Google tokens. Never change it after launch.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_KEY=

# Where the database lives. On a host, point this at the persistent volume (e.g. /data/hub.db).
DB_FILE=./data/hub.db

# Default time zone for new accounts (each student's browser sets their own when they sign up).
DEFAULT_TZ=Europe/Istanbul

# --- Optional: AI reading (much better at messy emails, pages and pasted messages) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# --- Optional: email forwarding (Kognity, K12net, Padlet, Outlook...) ---
# Domain that receives mail for the app, e.g. hubmail.com  -> students get addresses like x7k2...@hubmail.com
INBOUND_DOMAIN=
# Shared secret between your email service and the app. Long random string.
INBOUND_SECRET=

# --- Optional: "Connect Gmail" button ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
